# backend/.env.example
# Copy to .env and fill in real values before running locally or via Docker.

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentdb
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT — use long random strings (min 64 chars each)
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# SMTP — leave blank to use Ethereal auto-inbox (dev only, preview at ethereal.email)
# Fill in real values to send actual emails:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=TalentHub <your@gmail.com>

# URLs
# APP_URL is used to build public file URLs: <APP_URL>/uploads/<type>/<filename>
# Local dev : http://localhost:3000
# VPS prod  : https://ntlcareernexus.com
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# File uploads
# UPLOADS_PATH — absolute or relative path to the upload storage folder.
# Relative paths are resolved from the project root (where package.json lives).
# Local dev : uploads                               → <project>/uploads/
# VPS prod  : /var/www/ntlcareernexus/uploads
#   Subfolders created automatically: profiles/ resumes/ videos/ certificates/
#   Ensure the folder is writable by the Node process:
#     sudo mkdir -p /var/www/ntlcareernexus/uploads
#     sudo chown -R <node_user>:<group> /var/www/ntlcareernexus/uploads
UPLOADS_PATH=uploads

# ── VPS PRODUCTION OVERRIDES (set these in your production .env) ──────────────
# NODE_ENV=production
# APP_URL=https://ntlcareernexus.com
# FRONTEND_URL=https://ntlcareernexus.com
# UPLOADS_PATH=/var/www/ntlcareernexus/uploads
# CORS_ORIGIN=https://ntlcareernexus.com
