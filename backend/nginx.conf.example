# ==============================================================================
# nginx.conf.example — NTL Career Nexus (ntlcareernexus.com)
# ==============================================================================
#
# Copy the relevant server block into your Nginx site config, e.g.:
#   /etc/nginx/sites-available/ntlcareernexus.com
#
# Then enable it:
#   sudo ln -s /etc/nginx/sites-available/ntlcareernexus.com \
#              /etc/nginx/sites-enabled/ntlcareernexus.com
#   sudo nginx -t && sudo systemctl reload nginx
#
# Prerequisites on VPS:
#   1. Create and permission the uploads directory:
#        sudo mkdir -p /var/www/ntlcareernexus/uploads/{profiles,resumes,videos,certificates}
#        sudo chown -R <node_user>:<group> /var/www/ntlcareernexus/uploads
#        sudo chmod -R 755 /var/www/ntlcareernexus/uploads
#
#   2. Set these in your production backend/.env:
#        NODE_ENV=production
#        APP_URL=https://ntlcareernexus.com
#        FRONTEND_URL=https://ntlcareernexus.com
#        UPLOADS_PATH=/var/www/ntlcareernexus/uploads
#        CORS_ORIGIN=https://ntlcareernexus.com
#
#   3. Obtain SSL certificates (certbot recommended):
#        sudo certbot --nginx -d ntlcareernexus.com -d www.ntlcareernexus.com
#
# ==============================================================================

# Redirect HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ntlcareernexus.com www.ntlcareernexus.com;

    return 301 https://ntlcareernexus.com$request_uri;
}

# Redirect www → non-www (HTTPS)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.ntlcareernexus.com;

    ssl_certificate     /etc/letsencrypt/live/ntlcareernexus.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ntlcareernexus.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://ntlcareernexus.com$request_uri;
}

# Main HTTPS server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ntlcareernexus.com;

    # ── SSL (managed by certbot) ───────────────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/ntlcareernexus.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ntlcareernexus.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # ── Upload size — MUST accommodate 200 MB videos ──────────────────────────
    # Without this Nginx rejects large uploads with 413 before they reach Node.
    client_max_body_size 210m;

    # ── Timeouts for large file uploads ───────────────────────────────────────
    client_body_timeout   300s;
    proxy_connect_timeout 300s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;
    send_timeout          300s;

    # ── Serve uploaded files directly from disk (bypass Node entirely) ────────
    # Files are stored at: /var/www/ntlcareernexus/uploads/<type>/<uuid>.<ext>
    # Public URL:           https://ntlcareernexus.com/uploads/<type>/<uuid>.<ext>
    location /uploads/ {
        alias /var/www/ntlcareernexus/uploads/;

        # Cache uploaded files for 30 days in the browser
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";

        # Allow cross-origin requests (Angular frontend on same domain, but
        # the backend Node server sets this header too — belt-and-suspenders).
        add_header Cross-Origin-Resource-Policy "cross-origin";

        # Security: block directory listing and hidden files
        autoindex  off;

        # Disable access logging for static assets (reduces noise)
        access_log off;
    }

    # ── API — proxy to Node.js backend (port 3000) ────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Allow large request bodies for the API too (file upload endpoints)
        client_max_body_size 210m;
    }

    # ── Health check — proxy to Node ──────────────────────────────────────────
    location /health {
        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        access_log off;
    }

    # ── Angular frontend (SPA) ────────────────────────────────────────────────
    # Serve the built Angular app from the dist folder.
    # All unknown paths fall back to index.html for Angular routing.
    root /var/www/ntlcareernexus/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Gzip compression ──────────────────────────────────────────────────────
    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header X-Frame-Options        "SAMEORIGIN"   always;
    add_header X-Content-Type-Options "nosniff"      always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
}
