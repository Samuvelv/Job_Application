  "WHY": {
    "w1_title": "Uzavretá a overená platforma",
    "w1_desc": "Nie je to verejná tabuľa s pracovnými miestami. Každý kandidát a recruiter je osobitneschválený našim administračným tímom pred získaním prístupu.",
    "w2_title": "Vykonávame za vás prácu",
    "w2_desc": "Neuchádzate sa slepť do stoviek pracovných miest. Náš tím osobitnezhoduje a posiela váš profil správnemu zamestnávateľovi.",
    "w3_title": "Zameranie sa iba na sponzorstvo vizumu",
    "w3_desc": "Pracujeme iba so zamestnávateľmi, ktorí majú platné povolenie na sponzorstvo. Každá príležitosť na našej platforme je skutočná, právna a overená."
  },
  "STEPS": {
    "candidate1_title": "Registrácia a zaplatenie",
    "candidate1_desc": "Administrátori vytvoria váš profil a udelíia vám prístup na platformu. Náš tím vás bude kontaktovať do 24 hodín, aby začali vašu onboarding.",
    "candidate2_title": "Budujeme a zhodujeme váš profil",
    "candidate2_desc": "Náš tím osobitneskúma vaše pozadie, buduje váš profesionálny profil a zhoduje vás so zamestnávateľmi so sponzorovaným vizumom vo vašej zvolenej krajine.",
    "candidate3_title": "Vykonáme predstavu",
    "candidate3_desc": "Pošleme váš profil priamo zodpovedajúcim zamestnávateľom, usporiadame predstavu rozhovoru a vedieme vás cez proces vizuma krok za krokom.",
    "recruiter1_title": "Nastavte si svoj účet",
    "recruiter1_desc": "Administrátori vytvoria váš profil recruiterá a okamžite vám udelíia prístup k súboru talentov.",
    "recruiter2_title": "Hľadajte a zoznamuje si",
    "recruiter2_desc": "Používajte výkonné filtre na nájdenie kandidátov, ktorí spĺňajú vaše požiadavky. Uložte si najlepšie do svojho zoznamu.",
    "recruiter3_title": "Požiadajte a najímajte",
    "recruiter3_desc": "Požiadajte o kontaktné informácie svojich top kandidátov. Po schválení sa s nimi kontaktujte priamo a vykonajte nábor."
