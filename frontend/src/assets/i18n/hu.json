  "WHY": {
    "w1_title": "Zárt és ellenőrzött platform",
    "w1_desc": "Nem nyilvános munkaközvetítő. Minden jelölt és toborzó személyesen jóváhagyott admin csapatunk által a hozzáférés előtt.",
    "w2_title": "Mi végezzük el helyetted",
    "w2_desc": "Nem pályázol vakon százas munkahelyekre. Csapatunk személyesen illeszti és továbbítja a profilod a megfelelő munkaadóhoz.",
    "w3_title": "Csak vízum szponzorálásra összpontosít",
    "w3_desc": "Csak olyan munkaadókkal dolgozunk, akiknek érvényes szponzor licencük van. Minden lehetőség a platformon valós, jogi és ellenőrzött."
  },
  "STEPS": {
    "candidate1_title": "Regisztráció és fizetés",
    "candidate1_desc": "Az adminisztrátorok létrehozzák a profilját és megadják a platform hozzáférésit. Csapatunk 24 órán belül felveszi velünk a kapcsolatot az onboarding megkezdéséhez.",
    "candidate2_title": "Mi építjük és illesztjük a profilod",
    "candidate2_desc": "Csapatunk személyesen felülvizsgálja a háttérét, épít egy professzionális profilt, és illeszti a vízum-szponzorált munkaadókhoz a választott országban.",
    "candidate3_title": "Mi végezzük el a bemutatást",
    "candidate3_desc": "Közvetlenül továbbítjuk a profilot az illesztett munkaadókhoz, szervezünk interjúbemutatást, és végigvezetjük a vízumfolyamaton, lépésről lépésre.",
    "recruiter1_title": "Állítsa be a fiókját",
    "recruiter1_desc": "Az adminisztrátorok létrehozzák a toborzóprofilt és azonnal megadják a tehetségpuska hozzáférésit.",
    "recruiter2_title": "Keresés és kiválasztás",
    "recruiter2_desc": "Erőteljes szűrők segítségével keresse meg az igényeinek megfelelő jelölteket. Mentse a legjobbakat a listára.",
    "recruiter3_title": "Kérelem és felvétel",
    "recruiter3_desc": "Kérje a legjobb jelöltek kapcsolati adatait. Miután jóváhagyásra kerül, lépjen kapcsolatba közvetlenül, és végezze el a felvételt."
  },
  "TESTIMONIALS": {
    "t1_quote": "Az NTL Career Nexus lenyűgözően egyszerű volt a megfelelő előtér-fejlesztési szerep megtalálásához. Két héten belül három interjúkérés volt olyan cégtől, amelyekben valóban szeretnék dolgozni.",
