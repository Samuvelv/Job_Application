    "t3_role": "Full-Stack Mühendis, 3 Haftada Yerleştirildi",
    "t4_quote": "İşe alım sürecimizi NTL Career Nexus üzerinden yönetmek işe alım süremizi yarıya indirdi. Kısa liste ve iletişim iş akışı tam olarak ihtiyacımız olandı.",
    "t4_name": "Sophie Martin",
    "t4_role": "İK Müdürü, StartupX"
  },
