  "WHY": {
    "w1_title": "Öruggur og staðfestur vettvangur",
    "w1_desc": "Ekki opinber vinnustöð. Sérhver umsækjandi og ráðningamaður er persónulega samþykktur af okkar stjórnunarteymi áður en hann fær aðgang.",
    "w2_title": "Við gerum verkið fyrir þig",
    "w2_desc": "Ekki umsækjandi sem verður að nota margar völu stöðir. Okkar teymi jafnar þig persónulega og sendir þinn prófíl til huggulegra vinnuveitenda.",
    "w3_title": "Einungis styrkvísun",
    "w3_desc": "Við vinnumst aðeins við vinnuveitendur sem eru með gild styrkleyfi. Sérhver tækifæri á okkar vettvangi er raunverulegt, lögmætt og staðfest."
  },
  "STEPS": {
    "candidate1_title": "Skrá og byrja",
    "candidate1_desc": "Stjórnun myndar þinn prófíl og veiter þér aðgang að vettvangi. Okkar teymi mun hafa samband við þig innan 24 klukkustunda til að hefja þinn uppsetningarferli.",
    "candidate2_title": "Við byggjum og jafnum þinn prófíl",
    "candidate2_desc": "Okkar teymi fer markvisst yfir bakgrunn þinn, byggir þinn fagprófíl og jafnar þig við vinnuveitendur sem styrkja styrkvísun í völdu landi.",
    "candidate3_title": "Við kynnum",
    "candidate3_desc": "Við sendum þinn prófíl beint til aðeins samsvarandi vinnuveitenda, skipuleggjum viðtal þitt og leiðbeinum þér um styrkvísun skref fyrir skref.",
    "recruiter1_title": "Stilltu þinn reikning",
    "recruiter1_desc": "Stjórnun myndar þinn ráðningareikning og veiter þér aðgang að hæfileikagrunni núna.",
    "recruiter2_title": "Leita og vista",
    "recruiter2_desc": "Notaðu öflugar síur til að finna umsækjendur sem passa við þarfir þínar. Vistaðu bestu á þínum styttri lista.",
    "recruiter3_title": "Beiðni og ráða",
    "recruiter3_desc": "Biddu um samskiptaupplýsingar fyrir viðeigandi umsækjendur. Að fengið samþykki, hafðu samband við þá beint og sjá fram á endalok ráðningarinnar."
  },
  "TESTIMONIALS": {
    "t1_quote": "NTL Career Nexus gerði leitina að hugsuðu frontendhlutverk ótrúlega einfalt. Innan tveggja vikna hafði ég þrjár viðtalsbeiðnir frá fyrirtækjum sem vildu virkilega vinna.",
